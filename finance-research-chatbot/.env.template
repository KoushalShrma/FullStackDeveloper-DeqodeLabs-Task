# ==============================================================================
# CRITICAL - MUST CONFIGURE THESE
# ==============================================================================

# 🔐 JWT Secret (REQUIRED) - Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secure-256-bit-jwt-secret-key-change-this-in-production

# 🤖 AI Provider (REQUIRED) - Choose one: groq, openai, gemini, claude
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# 🔍 Search Provider (REQUIRED) - Choose one: tavily, brave, serper  
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key-here

# ==============================================================================
# DATABASE & CACHE (Auto-configured for Docker)
# ==============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_research
DB_USERNAME=app_user
DB_PASSWORD=app_password

REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# OPTIONAL - ALTERNATIVE API PROVIDERS
# ==============================================================================

# Alternative LLM providers
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here

# Alternative search providers  
BRAVE_API_KEY=your-brave-search-api-key-here
SERPER_API_KEY=your-serper-api-key-here

# ==============================================================================
# APPLICATION CONFIGURATION (Optional - has defaults)
# ==============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
JWT_EXPIRATION=86400000
MAX_CRAWL_PAGES=10
CRAWL_TIMEOUT=30000
SHORT_TERM_MEMORY_TTL=3600
MAX_THREAD_MESSAGES=100
REACT_APP_API_BASE_URL=http://localhost:8080