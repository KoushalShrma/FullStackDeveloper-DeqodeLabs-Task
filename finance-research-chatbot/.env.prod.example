# Production Environment Variables
# Copy this file to .env.prod and fill in your production values

# Database Configuration
MYSQL_ROOT_PASSWORD=your-super-secure-root-password-here
MYSQL_USER=finance_chatbot_user
MYSQL_PASSWORD=your-secure-database-password-here

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password-here

# JWT Security
JWT_SECRET=your-256-bit-jwt-secret-key-make-it-very-long-and-random-for-production

# AI/LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Search Provider Configuration
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key-here
SERPAPI_KEY=your-serpapi-key-here

# Domain Configuration
DOMAIN_NAME=your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# Monitoring and Logging
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30