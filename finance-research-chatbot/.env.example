# ===============================================
# FINANCE RESEARCH CHATBOT - ENVIRONMENT CONFIG
# ===============================================
# Copy this file to .env and fill in your actual values

# ===============================================
# 🤖 AI PROVIDER CONFIGURATION (REQUIRED)
# ===============================================
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
LLM_PROVIDER=groq

# ===============================================
# 🔍 SEARCH PROVIDER CONFIGURATION (REQUIRED)
# ===============================================
# Get your Tavily API key from: https://app.tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE
SEARCH_PROVIDER=tavily

# ===============================================
# 🗄️ DATABASE CONFIGURATION (DOCKER DEFAULTS)
# ===============================================
# For Docker development (keep these values as-is)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=finance_chatbot
DB_USERNAME=chatbot_user
DB_PASSWORD=chatbot_password

# For local development without Docker (uncomment if needed)
# DB_HOST=localhost
# DB_PORT=3307
# DB_NAME=finance_research
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password

# ===============================================
# 🔴 REDIS CACHE CONFIGURATION (DOCKER DEFAULTS)
# ===============================================
# For Docker development (keep these values as-is)
REDIS_HOST=redis
REDIS_PORT=6379

# For local development without Docker (uncomment if needed)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ===============================================
# 🔐 SECURITY CONFIGURATION
# ===============================================
# JWT Secret (auto-generated - safe to keep as-is)
JWT_SECRET=da98b37073876db5d188513d0b056e8fe5ba3b5f3b63ca9d8efd22e6a85c660f
JWT_EXPIRATION=86400000

# ===============================================
# 🌐 FRONTEND CONFIGURATION
# ===============================================
# API URL for frontend (keep as-is for local development)
REACT_APP_API_BASE_URL=http://localhost:8080

# CORS settings for development (keep as-is)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===============================================
# ⚙️ APPLICATION SETTINGS
# ===============================================
# Logging level (INFO is recommended)
LOG_LEVEL=INFO

# Memory and performance settings
SHORT_TERM_MEMORY_TTL=3600
MAX_THREAD_MESSAGES=100
MAX_CRAWL_PAGES=10
CRAWL_TIMEOUT=30000

# ===============================================
# 📊 OPTIONAL ALTERNATIVE PROVIDERS
# ===============================================
# Uncomment and configure if you want to use these instead

# OpenAI API (alternative to Groq)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai

# Claude API (alternative to Groq)
# CLAUDE_API_KEY=your_claude_api_key_here
# LLM_PROVIDER=claude

# Gemini API (alternative to Groq)
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini

# Alternative search providers
# BRAVE_API_KEY=your_brave_api_key_here
# SEARCH_PROVIDER=brave

# SERPER_API_KEY=your_serper_api_key_here
# SEARCH_PROVIDER=serper

# ===============================================
# 🚀 PRODUCTION DEPLOYMENT VARIABLES
# ===============================================
# Used when deploying to Railway, Heroku, etc.

# Spring Boot Profile for production
# SPRING_PROFILES_ACTIVE=production

# Database URL for PostgreSQL (Railway/Heroku)
# DATABASE_URL=postgresql://username:password@host:port/database

# Redis URL for production
# REDIS_URL=redis://username:password@host:port

# Production API URL for frontend
# REACT_APP_API_BASE_URL=https://your-backend-url.railway.app

# ===============================================
# 📖 QUICK START INSTRUCTIONS
# ===============================================
# 
# 1. COPY THIS FILE:
#    cp .env.example .env
#
# 2. GET API KEYS (both are FREE):
#    • Groq: https://console.groq.com/ 
#    • Tavily: https://app.tavily.com/
#
# 3. EDIT .env FILE:
#    Replace YOUR_GROQ_API_KEY_HERE with your actual Groq key
#    Replace YOUR_TAVILY_API_KEY_HERE with your actual Tavily key
#
# 4. START APPLICATION:
#    docker-compose up -d
#
# 5. OPEN IN BROWSER:
#    http://localhost:3000
#
# 🎉 That's it! Need help? Check README.md for detailed instructions.